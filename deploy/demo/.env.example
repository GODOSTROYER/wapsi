# Wapsi public demo: the model endpoint. Copy to deploy/demo/.env (gitignored), fill in, and run
#   docker run --rm -p 7860:7860 --env-file deploy/demo/.env wapsi-demo
# Never commit a real key. On Hugging Face Spaces and Streamlit Community Cloud these go into the host's
# settings instead (deploy/DEMO_HOSTING.md). Leave the three endpoint variables empty for the recorded run.

# Any OpenAI-compatible endpoint: the AMD Token Factory, or your own vLLM server on AMD
WAPSI_LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
WAPSI_LLM_API_KEY=
WAPSI_LLM_MODEL=Gemma-4-31B-IT

# Optional
# WAPSI_LLM_JSON_MODE=json_object        # json_object (default) | json_schema | none (send no response_format)
# WAPSI_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}   # e.g. switch a thinking model's thinking off
# WAPSI_LLM_PLATFORM=AMD                 # state where your own endpoint's GPUs are; *.amd.com(.cn) is recognised
# WAPSI_LLM_RPM=12                       # requests a minute the app may send (the Token Factory allows 20 per account)
# WAPSI_UI_LLM=auto                      # auto (default) | recorded (never call the endpoint) | live (never replay)
# WAPSI_UI_MAX_CASES=12                  # demo-world cases processed at start-up
