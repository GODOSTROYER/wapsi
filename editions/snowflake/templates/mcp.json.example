{
  "mcpServers": {
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "${WAPSI_JIRA_URL}",
        "JIRA_USERNAME": "${WAPSI_JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${WAPSI_JIRA_API_TOKEN}"
      }
    },
    "slack": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${WAPSI_SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${WAPSI_SLACK_TEAM_ID}"
      }
    },
    "wapsi": {
      "type": "http",
      "url": "https://${WAPSI_SNOWFLAKE_HOST}/api/v2/databases/WAPSI/schemas/APP/mcp-servers/WAPSI_MCP",
      "headers": {
        "Authorization": "Bearer ${WAPSI_SNOWFLAKE_PAT}",
        "X-Snowflake-Authorization-Token-Type": "PROGRAMMATIC_ACCESS_TOKEN"
      },
      "timeout": 60000
    }
  }
}
