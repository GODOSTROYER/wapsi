# syntax=docker/dockerfile:1.7
# ROCm PyTorch + the Python packages Wapsi's GNN and LoRA training need, for one MI300X (run_all.sh, stage env).
# The base image's torch is built for HIP and is NEVER replaced: requirements-rocm.txt is `uv export` of uv.lock with
# torch, triton, pytorch-triton, nvidia-* and cuda-* removed, installed with --no-deps so pip cannot pull a CUDA wheel
# back in.
# Library set vs the image's torch: uv.lock resolved transformers / peft / trl / accelerate / datasets against a newer
# CUDA torch, and --no-deps means pip never checks them against the image's torch (2.9.1). Their declared torch floors
# accept it (transformers >= 2.5, accelerate >= 2.0, peft >= 1.13; trl and datasets declare none; checked offline by
# tests/amd/test_amd_kickoff.py). Two checks run on the droplet: the import line below fails the build, and
# run_all.sh's env stage then runs editions/amd/kickoff/train_image_check.py in the image (imports, the declared
# ranges against the installed torch, one LoRA step on the GPU) and writes the versions into the evidence. If either
# fails, see RUNBOOK.md, Troubleshooting ("training image").
#   run_all.sh writes the context:  <work>/train-image/requirements-rocm.txt
#   docker build -f editions/amd/kickoff/Dockerfile.train --build-arg BASE_IMAGE=<rocm/pytorch pinned> \
#       -t wapsi-amd-train:local <work>/train-image
# The repository is mounted at /work at run time (not copied), so the image does not change when the code does.
ARG BASE_IMAGE=rocm/pytorch:rocm7.1_ubuntu24.04_py3.12_pytorch_release_2.9.1
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONPATH=/work/src:/work \
    HF_HOME=/hf

COPY requirements-rocm.txt /tmp/requirements-rocm.txt
RUN python3 -m pip install --no-deps -r /tmp/requirements-rocm.txt \
 && python3 -c "import torch, transformers, peft, trl; print('torch', torch.__version__, 'hip', torch.version.hip, 'transformers', transformers.__version__, 'peft', peft.__version__, 'trl', trl.__version__)"

WORKDIR /work
