# Endpoint mode: the variables `run_all.sh --mode endpoint`, the app and the benchmarks read.
# Copy this file to a PRIVATE place OUTSIDE the repository, fill in the key, and load it into your shell:
#   set -a; source /path/outside/git/amd_tokenfactory.env; set +a
# Never commit the key, paste it into a notebook cell output, a log, an issue or the video.
# (Not `editions/amd/.env`: that file configures the droplet's docker compose and is not read in endpoint mode.)

# ---------------------------------------------------------------- the endpoint (required)
# AMD Token Factory: OpenAI-compatible, models served on AMD GPUs. Any OpenAI-compatible vLLM URL works too.
WAPSI_LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
WAPSI_LLM_API_KEY=
# Drafting model. Gemma 4 is Google's open model (the Google partner technology of this entry).
# Leave empty to let the model plan pick the first served model of its list (Gemma-4-31B-IT first).
WAPSI_LLM_MODEL=Gemma-4-31B-IT

# ---------------------------------------------------------------- model plan (optional)
# A second, different, small model that screens untrusted complaint text next to the rules ("none" = rules only).
#WAPSI_JUDGE_MODEL=MiniCPM5-2B
# The catalogue changes. A named model that is not served stops the run; 1 = use the fallback list instead
# (Qwen3.8-27B, DeepSeek-V4-Flash, MiMo-V2.6-Flash, GLM-5.3-Flash) and flag it in the evidence.
#WAPSI_ALLOW_MODEL_FALLBACK=1
#WAPSI_LLM_FALLBACK_MODELS=Gemma-4-31B-IT,Qwen3.8-27B
# The same ordered list under the name voice intake and the agent read (they fail over along it while a model is
# withdrawn or answers in garbage, and label every result with the model that answered). One list is enough:
# the kickoff plan reads WAPSI_LLM_MODELS when WAPSI_LLM_FALLBACK_MODELS is not set.
#WAPSI_LLM_MODELS=Gemma-4-31B-IT,DeepSeek-V4-Flash,Qwen3.8-27B
#WAPSI_JUDGE_FALLBACK_MODELS=MiniCPM5-2B,Qwen3.8-27B

# ---------------------------------------------------------------- request shape (optional)
# json_object: the endpoint has no strict JSON schema (default for a provider's endpoint).
# json_schema: your own vLLM with guided decoding (default for a server on this machine).
#WAPSI_LLM_JSON_MODE=json_object
# Extra request fields for a model that needs them, and extra max_tokens for a model whose thinking counts as output.
# The fallback families that think get {"reasoning_effort": "low"} and 1024 on their own.
#WAPSI_LLM_EXTRA_BODY={"reasoning_effort": "low"}
#WAPSI_LLM_MAX_TOKENS_HEADROOM=1024
#WAPSI_LLM_TIMEOUT_S=180

# ---------------------------------------------------------------- limits of a shared trial key (optional)
# The account allows 20 requests a minute and 8 at once for the whole team. Stay below it.
#WAPSI_LLM_RPM=16
#WAPSI_LLM_MAX_CONCURRENCY=4
#WAPSI_LLM_MIN_INTERVAL_S=0
# Temperature-0 answers are cached here (gitignored); "off" disables the cache.
#WAPSI_LLM_CACHE_DIR=data/generated/llm-cache

# ---------------------------------------------------------------- run sizes (optional; 0 = every golden case)
#WAPSI_EP_FULL=1
#WAPSI_EP_EVAL_LIMIT=10
#WAPSI_EP_AB_LIMIT=10
#WAPSI_EP_E2E_LIMIT=6
#WAPSI_EP_BENCH_LEVELS=1 4 8
#WAPSI_EP_BENCH_REQUESTS=6
#WAPSI_E2E_WORLD=demo
#WAPSI_INR_PER_USD=

# ---------------------------------------------------------------- an endpoint that is not AMD's own (optional)
# Your own vLLM on AMD hardware behind a public URL: say what serves it. Recorded as declared, never as measured.
#WAPSI_ENDPOINT_HARDWARE=AMD Instinct MI300X, vLLM-ROCm
# The app's labels (the draft chip, voice intake, the agent) read the shorter statement of the same fact:
#WAPSI_LLM_PLATFORM=AMD
